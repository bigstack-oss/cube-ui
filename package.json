{
  "name": "@cube-ui/root",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "description": "Cube Design System Monorepo",
  "type": "module",
  "engines": {
    "node": ">=v24.15",
    "pnpm": ">=10.33"
  },
  "scripts": {
    "lint": "pnpm tsc && pnpm eslint && pnpm prettier",
    "format": "pnpm prettier:fix && pnpm eslint:fix",
    "test": "pnpm -r test",
    "tsc": "pnpm -r tsc",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "prettier": "prettier --check \"{**/*,*}.{js,ts,tsx,json,scss,md}\"",
    "prettier:fix": "prettier --write \"{**/*,*}.{js,ts,tsx,json,scss,md}\"",
    "build": "pnpm --filter \"@bigstack-oss/*\" build",
    "icons:generate": "pnpm --filter @bigstack-oss/cube-ui icons:generate",
    "i18n:sync": "pnpm --filter @bigstack-oss/cube-ui i18n:sync",
    "ui:dev": "pnpm --filter @bigstack-oss/cube-ui storybook",
    "ui:watch": "pnpm --filter @bigstack-oss/cube-ui build:watch",
    "ui:deploy-storybook": "pnpm --filter @bigstack-oss/cube-ui chromatic",
    "ui:publish": "pnpm --filter @bigstack-oss/cube-ui publish --access public --no-git-checks",
    "version": "pnpm build && changeset version",
    "release": "changeset publish && git push --follow-tags",
    "refresh": "rm -rf node_modules packages/*/node_modules pnpm-lock.yaml && pnpm install && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-storybook": "10.3.5",
    "eslint-plugin-tailwindcss": "3.17.5",
    "globals": "^17.5.0",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
