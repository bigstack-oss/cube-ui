{
  "name": "@bigstack-oss/cube-ui",
  "private": false,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "Cube UI Library",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "style": "./dist/index.css",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.mjs",
      "require": "./dist/icons.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm icons:generate && pnpm build:js && pnpm build:css",
    "build:js": "tsup",
    "build:css": "postcss src/tailwind.css -o dist/index.css",
    "build:watch": "pnpm icons:generate && pnpm build:css && tsup --watch",
    "dev": "tsup --watch & postcss src/tailwind.css -o dist/index.css --watch & wait",
    "build:storybook": "storybook build",
    "icons:generate": "node scripts/generate-icons.ts",
    "storybook": "pnpm icons:generate && storybook dev -p 6006 --no-open",
    "chromatic": "pnpm build:storybook && npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --storybook-build-dir=storybook-static",
    "tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "i18n:sync": "node scripts/syncI18n.ts"
  },
  "dependencies": {
    "@fontsource/inter": "catalog:",
    "@fontsource/noto-sans-tc": "catalog:",
    "@fontsource/urbanist": "catalog:",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@types/lodash": "catalog:",
    "autoprefixer": "catalog:",
    "chart.js": "^4.4.8",
    "class-variance-authority": "catalog:",
    "classnames": "^2.5.1",
    "dayjs": "catalog:",
    "i18next": "catalog:",
    "lodash": "catalog:",
    "prism-react-renderer": "^2.4.1",
    "prop-types": "^15.8.1",
    "react-chartjs-2": "^5.3.0",
    "react-i18next": "catalog:",
    "storybook": "^10.3.5",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "vite-plugin-svgr": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.3.5",
    "@svgr/cli": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chromatic": "^17.5.0",
    "code-inspector-plugin": "catalog:",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "jest-axe": "catalog:",
    "jsdom": "catalog:",
    "postcss": "catalog:",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "tsup": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "format": [
    "cjs",
    "esm"
  ],
  "outExtension": {
    "cjs": ".js",
    "esm": ".mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
